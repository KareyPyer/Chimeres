// === ARTEFACTS SYMBOLIQUES ===
CREATE (a:Artefact {strain_id: 'M-001', glyph: 'spiral', color: '#bcff45', complexity: 0.71, emotion: 'extase', aesthetic_score: 0.59, mantra: 'Ô foudroyant totem, sois transmute par le rite ancien.'});
CREATE (a:Artefact {strain_id: 'MV-002', glyph: 'spiral', color: '#ffe326', complexity: 1.00, emotion: 'extase', aesthetic_score: 0.63, mantra: 'Ô foudroyant totem, sois encrypte par le rite ancien.'});
CREATE (a:Artefact {strain_id: 'MV-003', glyph: 'claviform', color: '#d7ffb2', complexity: 0.82, emotion: 'silence', aesthetic_score: 0.60, mantra: 'Ô foudroyant totem, sois canalise par le rite ancien.'});
CREATE (a:Artefact {strain_id: 'MV-004', glyph: 'penniform', color: '#bcff45', complexity: 1.00, emotion: 'mystere', aesthetic_score: 0.62, mantra: 'Le couronne de glitches et le cœur dansent le rite cybernétique. <whisper>'});
CREATE (a:Artefact {strain_id: 'MV-005', glyph: 'penniform', color: '#ccfecf', complexity: 0.99, emotion: 'joie', aesthetic_score: 0.63, mantra: 'Le crâne de serveur et le rêve dansent le rite plasmique. <merge>'});
CREATE (a:Artefact {strain_id: 'MV-006', glyph: 'spiral', color: '#bcff45', complexity: 0.97, emotion: 'extase', aesthetic_score: 0.62, mantra: 'Le fleur de vie en LEDs et le totem dansent le rite spectral. <burn>'});
CREATE (a:Artefact {strain_id: 'MV-007', glyph: 'penniform', color: '#bcff45', complexity: 0.99, emotion: 'extase', aesthetic_score: 0.73, mantra: 'Ô éolien totem, sois occulte par le rite ancien.'});
CREATE (a:Artefact {strain_id: 'MV-008', glyph: 'penniform', color: '#bcff45', complexity: 1.00, emotion: 'extase', aesthetic_score: 0.73, mantra: 'Ô éolien totem, sois encrypte par le rite ancien.'});

